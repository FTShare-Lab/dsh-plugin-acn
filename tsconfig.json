{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@ftai/dsh-plugin-acn/store": ["./src/store/index.ts"],
      "@ftai/dsh-plugin-acn/protocol": ["./src/protocol/index.ts"]
    },
    "types": [
      "node"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "*.config.ts",
    "src/**/*.tsx",
    "tests/**/*.tsx"
  ]
}
